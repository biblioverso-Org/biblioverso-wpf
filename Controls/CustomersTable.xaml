<UserControl x:Class="library.Controls.CustomersTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:models="clr-namespace:library.Models;assembly=library"
             xmlns:converters="clr-namespace:library.Converters"
             xmlns:behaviors="clr-namespace:library.Behaviors"
             x:Name="root">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Themes/CustomersTable.Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:InitialsConverter x:Key="Initials" />
            <converters:SafeImageSourceConverter x:Key="SafeImg" />
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:VisibilityBooleanConverter x:Key="VisToBool" />

            <!-- Convierte el conteo de items en visibilidad -->
            <converters:CountToVisibilityConverter x:Key="CountToVisibility"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- ===== Tabla clientes ===== -->
        <DataGrid x:Name="GridTable"
                  Background="{DynamicResource App.CardBrush}"
                  ItemsSource="{Binding CustomersView}"
                  AutoGenerateColumns="False"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalAlignment="Stretch"
                  HorizontalAlignment="Stretch"
                  CanUserAddRows="False" CanUserReorderColumns="False"
                  CanUserResizeColumns="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" RowHeaderWidth="0"
                  SelectionUnit="FullRow"
                  ColumnHeaderStyle="{StaticResource SlimHeader}"
                  CellStyle="{StaticResource CenterCell}"
                  HorizontalGridLinesBrush="{DynamicResource RowSeparator}"
                  materialDesign:DataGridAssist.CellPadding="12,8"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="12,10"
                  IsReadOnly="True"
                  RowDetailsVisibilityMode="Collapsed"
                  ScrollViewer.CanContentScroll="False"
                  EnableRowVirtualization="False"
                  VirtualizingPanel.IsVirtualizing="False"
                  Visibility="{Binding Customers.Count, 
                                       Converter={StaticResource CountToVisibility}, 
                                       ConverterParameter=HasItems}"
                  behaviors:AdaptiveColumnsBehavior.Breakpoints="
                        1100:Address;
                        1080:Phone;
                        980:Email;
                        900:Gender;
                        840:CI;">

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource SlimRow}" />
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <!-- CLIENTE -->
                <DataGridTemplateColumn Header="CLIENTE" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Foto / iniciales -->
                                <Border Width="35" Height="35" CornerRadius="16"
                                        Margin="0,0,8,0"
                                        BorderBrush="{DynamicResource App.BorderBrush}" BorderThickness="1">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Foto, Converter={StaticResource SafeImg}}"
                                                    Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>

                                <!-- Nombre + email -->
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" 
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource App.TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Email}" 
                                               FontSize="11"
                                               Foreground="{DynamicResource App.TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- TELÉFONO -->
                <DataGridTemplateColumn Header="TELÉFONO" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <mah:PackIconMaterial Kind="Phone" Width="14" Height="14"
                                                      Foreground="{DynamicResource App.IconBrush}"/>
                                <TextBlock Text="{Binding Telefono}" Margin="6 0 0 0" 
                                           Foreground="{DynamicResource App.TextPrimaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- DIRECCIÓN -->
                <DataGridTemplateColumn Header="DIRECCIÓN" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <mah:PackIconMaterial Kind="HomeOutline" Width="14" Height="14"
                                                      Foreground="{DynamicResource App.IconBrush}"/>
                                <TextBlock Margin="6 0 0 0" Text="{Binding Direccion}" 
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource App.TextSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- GÉNERO -->
                <DataGridTemplateColumn Header="GÉNERO" Width="*" SortMemberPath="Genero"
                                        behaviors:AdaptiveColumnsBehavior.Key="Genero">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="chip"
                                    Padding="8,2" CornerRadius="12"
                                    BorderThickness="1" Margin="0,0,4,0"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Genero}" FontSize="12" FontWeight="SemiBold"/>
                            </Border>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Genero}" Value="Masculino">
                                    <Setter TargetName="chip" Property="Background" Value="#DBEAFE"/>
                                    <Setter TargetName="chip" Property="BorderBrush" Value="#2563EB"/>
                                    <Setter TargetName="chip" Property="TextElement.Foreground" Value="#1E3A8A"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Genero}" Value="Femenino">
                                    <Setter TargetName="chip" Property="Background" Value="#FCE7F3"/>
                                    <Setter TargetName="chip" Property="BorderBrush" Value="#DB2777"/>
                                    <Setter TargetName="chip" Property="TextElement.Foreground" Value="#9D174D"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Genero}" Value="Otro">
                                    <Setter TargetName="chip" Property="Background" Value="#D1FAE5"/>
                                    <Setter TargetName="chip" Property="BorderBrush" Value="#059669"/>
                                    <Setter TargetName="chip" Property="TextElement.Foreground" Value="#064E3B"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- ACCIÓN -->
                <DataGridTemplateColumn behaviors:AdaptiveColumnsBehavior.Key="Action"
                                        CanUserSort="False" Header="ACCIÓN" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource GhostIconButton}" ToolTip="Editar"
                                        Command="{Binding DataContext.EditCustomerCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <mah:PackIconMaterial Kind="SquareEditOutline" Width="18" Height="18"
                                                          Foreground="{DynamicResource Brush.Icon}" />
                                </Button>
                                <Button Style="{StaticResource GhostIconButton}" ToolTip="Eliminar"
                                        Command="{Binding DataContext.DeleteCustomerCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <mah:PackIconMaterial Kind="TrashCanOutline" Width="18" Height="18"
                                                          Foreground="{DynamicResource Brush.Icon}" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ===== Estado vacío ===== -->
        <StackPanel Visibility="{Binding Customers.Count, 
                                          Converter={StaticResource CountToVisibility}, 
                                          ConverterParameter=Empty}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="20"
                    Orientation="Vertical"
                    Width="400">
            <mah:PackIconMaterial Kind="AccountMultipleOutline"
                                  Width="64" Height="64"
                                  Foreground="{DynamicResource App.IconBrush}"
                                  HorizontalAlignment="Center"/>
            <TextBlock Text="No hay clientes aún"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource App.TextPrimaryBrush}"
                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <TextBlock Text="Agrega un cliente para empezar a gestionar tu biblioteca."
                       FontSize="13"
                       Foreground="{DynamicResource App.TextSecondaryBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>
            <Button Content="Agregar cliente"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{Binding AddCustomerAsyncCommand}"
                    HorizontalAlignment="Center"
                    Margin="0,14,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
