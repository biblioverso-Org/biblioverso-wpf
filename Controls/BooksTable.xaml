<!-- Controls/BooksTable.xaml -->
<UserControl x:Class="library.Controls.BooksTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:converters="clr-namespace:library.Converters"
             xmlns:behaviors="clr-namespace:library.Behaviors">

    <!-- Recursos -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Themes/CustomersTable.Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:SafeImageSourceConverter x:Key="SafeImg" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TABLA -->
        <DataGrid Grid.Row="0"
                  Background="{DynamicResource App.CardBrush}"
                  ItemsSource="{Binding LibrosView}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  SelectionUnit="FullRow"
                  ColumnHeaderStyle="{StaticResource SlimHeader}"
                  RowStyle="{StaticResource SlimRow}"
                  CellStyle="{StaticResource CenterCell}"
                  HorizontalGridLinesBrush="{StaticResource RowSeparator}"
                  materialDesign:DataGridAssist.CellPadding="12,8"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="12,10"
                  IsReadOnly="True"
                  behaviors:AdaptiveColumnsBehavior.Breakpoints="
                    1150:Stock;
                    1100:Year;
                    1020:Genero;
                    940:ISBN;
                    860:Autores;">

            <DataGrid.Columns>

                <!-- Columna combinada: Portada + Info -->
                <DataGridTemplateColumn Header="LIBRO" Width="2*"
                        behaviors:AdaptiveColumnsBehavior.Key="Libro">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,2">
                                <!-- Portada -->
                                <Border Width="40" Height="54" CornerRadius="4"
                        BorderBrush="{DynamicResource App.BorderBrush}" BorderThickness="1"
                        Margin="0,0,10,0">
                                    <Border.Background>
                                        <ImageBrush Stretch="UniformToFill"
                                    ImageSource="{Binding Portada, Converter={StaticResource SafeImg}}"/>
                                    </Border.Background>
                                </Border>

                                <!-- Info del libro -->
                                <StackPanel>
                                    <!-- Título -->
                                    <TextBlock Text="{Binding Titulo}" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource App.TextPrimaryBrush}"
                                               TextWrapping="Wrap"/>

                                    <!-- ISBN -->
                                    <TextBlock Text="{Binding ISBN}" 
                               FontSize="11"
                               Foreground="{DynamicResource App.TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Autores -->
                                    <TextBlock Text="{Binding AutoresTexto}" 
                               FontSize="11"
                               Foreground="{DynamicResource App.TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Editorial -->
                <DataGridTextColumn Header="EDITORIAL"
                    SortMemberPath="Editorial"
                    behaviors:AdaptiveColumnsBehavior.Key="EDITORIAL"
                    Binding="{Binding EditorialTexto}"
                    ElementStyle="{StaticResource CellTextCenter}" Width="*" />

                <!-- Género -->
                <DataGridTextColumn Header="GÉNERO"
                    SortMemberPath="Genero"
                    behaviors:AdaptiveColumnsBehavior.Key="Genero"
                    Binding="{Binding GeneroTexto}"
                    ElementStyle="{StaticResource CellTextCenter}" Width="*" />


                <!-- Año -->
                    <DataGridTextColumn Header="AÑO"
                                    SortMemberPath="FechaPublicacion"
                                    behaviors:AdaptiveColumnsBehavior.Key="Year"
                                    Binding="{Binding FechaPublicacion.Year}"
                                    ElementStyle="{StaticResource CellTextCenter}" Width="*" />

                   

                    <!-- Acción -->
                    <DataGridTemplateColumn Header="ACCIÓN" Width="120" CanUserSort="False"
                                        behaviors:AdaptiveColumnsBehavior.Key="Action">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource GhostIconButton}" ToolTip="Gestionar stock"
        Command="{Binding DataContext.ManageStockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
        CommandParameter="{Binding}">
                                    <mah:PackIconMaterial Kind="BookCogOutline" Width="18" Height="18"
                          Foreground="#6B7280" />
                                </Button>
                                <Button Style="{StaticResource GhostIconButton}" ToolTip="Editar"
                                        Command="{Binding DataContext.EditBookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                        <mah:PackIconMaterial Kind="SquareEditOutline" Width="18" Height="18"
                                                          Foreground="#6B7280" />
                                    </Button>
                                    <Button Style="{StaticResource GhostIconButton}" ToolTip="Eliminar"
                                        Command="{Binding DataContext.DeleteBookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                        <mah:PackIconMaterial Kind="TrashCanOutline" Width="18" Height="18"
                                                          Foreground="#6B7280" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
