<UserControl x:Class="library.Controls.CategoriesHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/iconpacks"
             x:Name="root">

    <Grid Margin="12,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal"
         Grid.Column="0"
         VerticalAlignment="Center">
            <TextBlock Text="Categorias"
          FontWeight="SemiBold"
          FontSize="16"
          Foreground="{StaticResource TitleFg}"
          Margin="0,0,6,0" />
            <mah:PackIconMaterial Kind="ArrowTopRight"
                     Width="12" Height="12"
                     VerticalAlignment="Center" />
        </StackPanel>
        <!-- Botones de acción -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <!-- Botón agregar -->
            <Button Margin="0,0,8,0"
                    Command="{Binding AddCategoriaCommand}">
                <StackPanel Orientation="Horizontal">
                    <mah:PackIconMaterial Kind="Plus" Width="18" Height="18" Margin="0,0,4,0"/>
                    <TextBlock Text="Agregar"/>
                </StackPanel>
            </Button>

            <!-- Botón reporte -->
            <Button 
                    Command="{Binding GenerateCategoriasReportCommand}">
                <StackPanel Orientation="Horizontal">
                    <mah:PackIconMaterial Kind="FileChartOutline" Width="18" Height="18" Margin="0,0,4,0"/>
                    <TextBlock Text="Reporte"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
