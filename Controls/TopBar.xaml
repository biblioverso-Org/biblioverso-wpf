<UserControl x:Class="library.Controls.TopBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="root"
             SnapsToDevicePixels="True"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToIconConverter x:Key="BoolToIcon" xmlns:converters="clr-namespace:library.Converters" />

        <!-- Botón icono -->
        <Style x:Key="HeaderIconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="10" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- === LAYOUT PRINCIPAL === -->
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <!-- Sección -->
            <ColumnDefinition Width="*" />
            <!-- Buscador -->
            <ColumnDefinition Width="Auto"/>
            <!-- Acciones -->
        </Grid.ColumnDefinitions>

        <!-- ====== TÍTULO Y DESCRIPCIÓN (sin Card) ====== -->
        <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="4,0,16,0">
            <TextBlock Text="{Binding SectionTitle}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text}" />
            <TextBlock Text="{Binding SectionDescription}"
                       FontSize="13"
                       Foreground="{DynamicResource Brush.TextMuted}"
                       Margin="0,2,0,0" />
        </StackPanel>

        <!-- ====== BUSCADOR ====== -->
        <materialDesign:Card Grid.Column="1"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Background="{DynamicResource Brush.Card}"
                             BorderBrush="{DynamicResource Brush.Border}"
                             UniformCornerRadius="10"
                             Padding="10,4"
                             Margin="0,0,12,0">
            <Grid Width="340" Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icono lupa -->
                <mah:PackIconMaterial Grid.Column="0"
                                      Kind="Magnify"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      Width="18"
                                      Height="18"
                                      Foreground="{DynamicResource Brush.TextMuted}" />

                <!-- Caja búsqueda -->
                <TextBox Grid.Column="1"
                         x:Name="SearchBox"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         Padding="8,0"
                         FontSize="14"
                         Foreground="{DynamicResource Brush.Text}"
                         materialDesign:HintAssist.Hint="Buscar (Ctrl+/)"
                         Text="{Binding DataContext.GlobalSearch,
                                        RelativeSource={RelativeSource AncestorType=Window},
                                        UpdateSourceTrigger=PropertyChanged}" />
               
                <!-- Limpiar -->
                <Button Grid.Column="3"
                        Command="{Binding ClearSearchCommand}"
                        Style="{StaticResource HeaderIconButton}">
                    <mah:PackIconMaterial Kind="CloseCircleOutline"
                                          Width="18"
                                          Height="18"
                                          Foreground="{DynamicResource Brush.TextMuted}" />
                </Button>
            </Grid>
        </materialDesign:Card>

        <!-- ====== ACCIONES DERECHA ====== -->
        <materialDesign:Card Grid.Column="2"
                             Background="{DynamicResource Brush.Card}"
                             BorderBrush="{DynamicResource Brush.Border}"
                             UniformCornerRadius="10"
                             Padding="4"
                             VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="8,0">
                <!-- Tema -->
                <Button Command="{Binding ToggleThemeCommand}"
                        Style="{StaticResource HeaderIconButton}">
                    <mah:PackIconMaterial Width="18"
                                          Height="18"
                                          Foreground="{DynamicResource Brush.Text}"
                                          Kind="{Binding IsDarkTheme,
                                                         Converter={StaticResource BoolToIcon},
                                                         ConverterParameter='WeatherNight|WhiteBalanceSunny'}" />
                </Button>

                <!-- Usuario -->
                <Button Style="{StaticResource HeaderIconButton}"
                        Command="{Binding EditUserCommand}"
                        CommandParameter="{Binding CurrentUser}">
                    <mah:PackIconMaterial Kind="FaceManProfile"
                                          Width="18"
                                          Height="18" />
                </Button>

                <!-- Notificaciones -->
                <Grid>
                    <Button Style="{StaticResource HeaderIconButton}"
                            Command="{Binding OpenNotificationsCommand}">
                        <mah:PackIconMaterial Kind="BellOutline"
                                              Width="18"
                                              Height="18"
                                              Foreground="{DynamicResource Brush.Text}" />
                    </Button>
                    <Border Background="#FFEB5757"
                            CornerRadius="8"
                            MinWidth="16"
                            Height="16"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,0,2,0"
                            Visibility="{Binding HasNotifications, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding NotificationsCount}"
                                   Foreground="White"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
