<UserControl x:Class="library.Controls.OrdersTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:behaviors="clr-namespace:library.Behaviors">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Themes/CustomersTable.Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Chip de estado -->
            <Style x:Key="StatusChip" TargetType="Border">
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Background" Value="#EEF2F6"/>
                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="TextElement.Foreground" Value="#475569"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Estado}" Value="pendiente">
                        <Setter Property="Background" Value="#FFF7E6"/>
                        <Setter Property="BorderBrush" Value="#FFE8C7"/>
                        <Setter Property="TextElement.Foreground" Value="#B45309"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Estado}" Value="notificado">
                        <Setter Property="Background" Value="#E6F4FF"/>
                        <Setter Property="BorderBrush" Value="#CFE8FF"/>
                        <Setter Property="TextElement.Foreground" Value="#1D4ED8"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Estado}" Value="completada">
                        <Setter Property="Background" Value="#EAF7EF"/>
                        <Setter Property="BorderBrush" Value="#D2EFE0"/>
                        <Setter Property="TextElement.Foreground" Value="#047857"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Estado}" Value="cancelada">
                        <Setter Property="Background" Value="#FEE2E2"/>
                        <Setter Property="BorderBrush" Value="#FECACA"/>
                        <Setter Property="TextElement.Foreground" Value="#B91C1C"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <DataGrid x:Name="GridOrders"
              ItemsSource="{Binding OrdersView}"
                  
                   Background="{DynamicResource App.CardBrush}"
              AutoGenerateColumns="False"
              CanUserAddRows="False" CanUserReorderColumns="False"
              CanUserResizeColumns="False" CanUserDeleteRows="False"
              HeadersVisibility="Column" RowHeaderWidth="0"
              SelectionUnit="FullRow"
              ColumnHeaderStyle="{StaticResource SlimHeader}"
              RowStyle="{StaticResource SlimRow}"
              CellStyle="{StaticResource CenterCell}"
              HorizontalGridLinesBrush="{StaticResource RowSeparator}"
              materialDesign:DataGridAssist.CellPadding="12,8"
              materialDesign:DataGridAssist.ColumnHeaderPadding="12,10"
              IsReadOnly="True"
              VerticalAlignment="Stretch"
              HorizontalAlignment="Stretch"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              behaviors:AdaptiveColumnsBehavior.Breakpoints="
                    1200:FechaReserva;
                    1000:Usuario.NombreCompleto;
                     900:Libro.Titulo;
                     820:Estado;">

            <DataGrid.Columns>


                <DataGridTemplateColumn Header="MIEMBRO" Width="2*" SortMemberPath="Usuario.NombreCompleto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Avatar usuario -->
                                <Ellipse Width="32" Height="32" Margin="0,0,8,0">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding Usuario.Foto}" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock Text="{Binding Usuario.NombreCompleto}" VerticalAlignment="Center"
                               FontWeight="SemiBold"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Libro con portada -->
                <DataGridTemplateColumn Header="LIBRO" Width="2*" SortMemberPath="Libro.Titulo">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="32" Height="48" Margin="0,0,8,0" CornerRadius="2" BorderThickness="1" BorderBrush="#DDD">
                                    <Image Source="{Binding Libro.Portada}" Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock Text="{Binding Libro.Titulo}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Fecha reserva -->
                <DataGridTextColumn Header="FECHA RESERVA" SortMemberPath="FechaReserva"
                            Binding="{Binding FechaReserva, StringFormat=\{0:dd/MM/yyyy\}}" Width="*"
                            ElementStyle="{StaticResource CellTextCenter}"/>

                <DataGridTemplateColumn Header="ESTADO" Width="*" SortMemberPath="Estado">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="chip"
                    Padding="8,2" CornerRadius="12"
                    BorderThickness="1" Margin="0,0,4,0"
                    HorizontalAlignment="Center"
                    Background="#F3F4F6"   
                                BorderBrush="#CBD5E1"
                                
                                >
                                <TextBlock Text="{Binding Estado}" 
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="#374151"/>
                            </Border>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Estado}" Value="pendiente">
                                    <Setter TargetName="chip" Property="Background" Value="#DBEAFE"/>
                                    <Setter TargetName="chip" Property="BorderBrush" Value="#2563EB"/>
                                    <Setter TargetName="chip" Property="TextElement.Foreground" Value="#1E3A8A"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Estado}" Value="notificado">
                                    <Setter TargetName="chip" Property="Background" Value="#FCE7F3"/>
                                    <Setter TargetName="chip" Property="BorderBrush" Value="#DB2777"/>
                                    <Setter TargetName="chip" Property="TextElement.Foreground" Value="#9D174D"/>
                                </DataTrigger>

                                <!-- corregido: cancelada -->
                                <DataTrigger Binding="{Binding Estado}" Value="cancelada">
                                    <Setter TargetName="chip" Property="Background" Value="#FEE2E2"/>
                                    <Setter TargetName="chip" Property="BorderBrush" Value="#DC2626"/>
                                    <Setter TargetName="chip" Property="TextElement.Foreground" Value="#7F1D1D"/>
                                </DataTrigger>

                                <!-- corregido: completada -->
                                <DataTrigger Binding="{Binding Estado}" Value="completada">
                                    <Setter TargetName="chip" Property="Background" Value="#D1FAE5"/>
                                    <Setter TargetName="chip" Property="BorderBrush" Value="#059669"/>
                                    <Setter TargetName="chip" Property="TextElement.Foreground" Value="#064E3B"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- ACCIONES -->
                <DataGridTemplateColumn Header="ACCIÓN" Width="180" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                                <!-- Realizar préstamo -->
                                <Button Style="{StaticResource GhostIconButton}"
                        ToolTip="Realizar préstamo"
                        Command="{Binding DataContext.StartLoanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}">
                                    <mah:PackIconMaterial Kind="BookCheckOutline" Width="18" Height="18" Foreground="#6B7280"/>
                                </Button>

                                <!-- Cancelar reserva -->
                                <Button Style="{StaticResource GhostIconButton}" Margin="6,0,0,0"
                        ToolTip="Cancelar reserva"
                        Command="{Binding DataContext.CancelReservationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}">
                                    <mah:PackIconMaterial Kind="CloseCircleOutline" Width="18" Height="18" Foreground="#6B7280"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
