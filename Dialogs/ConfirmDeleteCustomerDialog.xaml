<UserControl x:Class="library.Dialogs.ConfirmDeleteCustomerDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:converters="clr-namespace:library.Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             MinWidth="460" MaxWidth="600">

    <!-- ===== Recursos (Theme-aware) ===== -->
    <UserControl.Resources>
        <converters:InitialsConverter x:Key="Initials"/>
        <converters:SafeImageSourceConverter x:Key="SafeImg"/>

        <!-- Botones tipo píldora (base) -->
        <Style x:Key="PillButtonBase" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <!-- Variantes -->
        <Style x:Key="PillOutlineButton" TargetType="Button" BasedOn="{StaticResource PillButtonBase}"/>
        <Style x:Key="PillDangerButton"  TargetType="Button" BasedOn="{StaticResource PillButtonBase}">
            <Setter Property="Background"  Value="{DynamicResource App.ErrorBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource App.ErrorBrush}"/>
            <Setter Property="Foreground"  Value="White"/>
        </Style>
    </UserControl.Resources>

    <!-- ===== Contenido ===== -->
    <Border Padding="24,20,24,16"
            Background="{DynamicResource App.CardBrush}"
            BorderBrush="{DynamicResource App.BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="*"/>
                <!-- Body -->
                <RowDefinition Height="Auto"/>
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <mah:PackIconMaterial Kind="TrashCanOutline"
                                      Width="22" Height="22"
                                      Foreground="{DynamicResource App.ErrorBrush}"
                                      DockPanel.Dock="Left"/>
                <TextBlock Text="Eliminar cliente"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
            </DockPanel>

            <!-- Body -->
            <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center">
                <!-- Avatar -->
                <Grid Width="72" Height="72" Margin="0,0,0,12">
                    <Ellipse Fill="{DynamicResource App.DividerBrush}" Opacity="0.3"/>

                    <!-- Foto -->
                    <Ellipse>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Foto}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Foto}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                        <Ellipse.Fill>
                            <ImageBrush Stretch="UniformToFill"
                                        ImageSource="{Binding Foto, Converter={StaticResource SafeImg}}"/>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- Iniciales -->
                    <Border CornerRadius="36"
                            Background="{DynamicResource App.SurfaceBrush}"
                            BorderBrush="{DynamicResource App.BorderBrush}" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Foto}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Foto}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding FullName, Converter={StaticResource Initials}}"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   FontWeight="Bold" FontSize="16"
                                   Foreground="{DynamicResource App.TextSecondaryBrush}"/>
                    </Border>
                </Grid>

                <!-- Datos -->
                <TextBlock Text="{Binding FullName}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource App.TextPrimaryBrush}"
                           FontSize="16" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Email}"
                           Foreground="{DynamicResource App.TextSecondaryBrush}"
                           HorizontalAlignment="Center"/>
                

                <!-- Mensaje -->
                <TextBlock Text="¿Seguro que deseas eliminar este cliente? Esta acción no se puede deshacer."
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{DynamicResource App.TextPrimaryBrush}"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Footer -->
            <DockPanel Grid.Row="2" LastChildFill="False" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Style="{StaticResource PillDangerButton}" DockPanel.Dock="Right"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                         CommandParameter="{x:Static sys:Boolean.TrueString}"

                        >
                    <StackPanel Orientation="Horizontal">
                        <mah:PackIconMaterial Kind="TrashCanOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Eliminar"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource PillOutlineButton}" DockPanel.Dock="Right" Margin="8,0,0,0"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                         CommandParameter="{x:Static sys:Boolean.FalseString}"
>
                    <StackPanel Orientation="Horizontal">
                        <mah:PackIconMaterial Kind="Close" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Cancelar"/>
                    </StackPanel>
                </Button>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
