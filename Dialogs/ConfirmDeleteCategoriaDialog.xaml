<UserControl x:Class="library.Dialogs.ConfirmDeleteCategoriaDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:dialogHost="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             MinWidth="400" MaxWidth="500">

    <Border Padding="24,20,24,16"
            Background="{DynamicResource App.CardBrush}"
            BorderBrush="{DynamicResource App.BorderBrush}"
            BorderThickness="1" CornerRadius="10">

        <StackPanel>
            <TextBlock Text="Eliminar Categoría"
                       FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>

            <TextBlock Text="¿Estás seguro que deseas eliminar esta categoría?"
                       Margin="0,0,0,12"/>

            <TextBlock Text="{Binding Nombre}"
                       FontWeight="Bold" FontSize="14"
                       Foreground="{DynamicResource App.TextPrimaryBrush}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button  Background="Red"
                        Command="{x:Static dialogHost:DialogHost.CloseDialogCommand}"
                        CommandParameter="True">
                    <TextBlock Text="Eliminar"/>
                </Button>
                <Button  Margin="8,0,0,0"
                        Command="{x:Static dialogHost:DialogHost.CloseDialogCommand}"
                        CommandParameter="{x:Null}">
                    <TextBlock Text="Cancelar"/>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
