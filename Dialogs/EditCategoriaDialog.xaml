<UserControl x:Class="library.Dialogs.EditCategoriaDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:dialogHost="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             MinWidth="400" MaxWidth="500">

    <Border Padding="24,20,24,16"
            Background="{DynamicResource App.CardBrush}"
            BorderBrush="{DynamicResource App.BorderBrush}"
            BorderThickness="1" CornerRadius="10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Editar Categoría"
                       FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>

            <TextBox Grid.Row="1"
                     materialDesign:HintAssist.Hint="Nombre"
                     Text="{Binding Nombre}" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button 
                        Command="{x:Static dialogHost:DialogHost.CloseDialogCommand}"
                        CommandParameter="{Binding}">
                    <TextBlock Text="Guardar"/>
                </Button>
                <Button  Margin="8,0,0,0"
                        Command="{x:Static dialogHost:DialogHost.CloseDialogCommand}"
                        CommandParameter="{x:Null}">
                    <TextBlock Text="Cancelar"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
