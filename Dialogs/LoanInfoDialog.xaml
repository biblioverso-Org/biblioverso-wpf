<UserControl x:Class="library.Dialogs.LoanInfoDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/iconpacks"
             MinWidth="540" MaxWidth="720" MaxHeight="480">

    <Border Padding="22"
            Background="{DynamicResource App.CardBrush}"
            BorderBrush="{DynamicResource App.BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">

        <Grid>
            <!-- ======== Definición de filas ======== -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- =================== HEADER =================== -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <mah:PackIconMaterial Kind="InformationOutline"
                                      Width="20" Height="20"
                                      Foreground="{DynamicResource App.PrimaryBrush}"
                                      Margin="0,0,8,0"/>
                <TextBlock Text="Información del préstamo"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource App.TextPrimaryBrush}"/>
            </StackPanel>

            <!-- =================== CONTENT =================== -->
            <Grid Grid.Row="1">
                <!-- ✅ Definición correcta de columnas -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- 📚 Resumen del libro -->
                <Border Grid.Column="0"
                        Margin="0,0,12,0"
                        Padding="12"
                        Background="{DynamicResource App.ElevatedBrush}"
                        BorderBrush="{DynamicResource App.BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <Image Source="{Binding Libro.Portada}"
                               Height="150"
                               Stretch="UniformToFill"
                               Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Libro.Titulo}"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding Usuario.NombreCompleto}"
                                   Foreground="#6B7280"
                                   Margin="0,4,0,10"/>
                        <TextBlock Text="{Binding Estado, StringFormat='Estado: {0}'}"
                                   FontWeight="SemiBold"
                                   Foreground="#2563EB"/>
                    </StackPanel>
                </Border>

                <!-- 📅 Detalles -->
                <StackPanel Grid.Column="1" VerticalAlignment="Top">

                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="Fecha préstamo:" Width="120"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding FechaPrestamo, StringFormat={}{0:dd/MM/yyyy}}"
                                   Foreground="{DynamicResource App.TextPrimaryBrush}"/>
                    </DockPanel>

                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="Vencimiento:" Width="120"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding FechaVencimiento, StringFormat={}{0:dd/MM/yyyy}}"
                                   Foreground="{DynamicResource App.TextPrimaryBrush}"/>
                    </DockPanel>

                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="Devolución:" Width="120"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding FechaDevolucion, TargetNullValue='—'}"
                                   Foreground="{DynamicResource App.TextPrimaryBrush}"/>
                    </DockPanel>

                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="Código préstamo:" Width="120"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource App.TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding IdPrestamo}"
                                   Foreground="{DynamicResource App.TextPrimaryBrush}"/>
                    </DockPanel>
                </StackPanel>
            </Grid>

            <!-- =================== FOOTER =================== -->
            <DockPanel Grid.Row="2"
                       Margin="0,16,0,0"
                       LastChildFill="False">
                <Button DockPanel.Dock="Right"
                        Margin="8,0,0,0"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                        CommandParameter="{x:Null}">
                    <StackPanel Orientation="Horizontal">
                        <mah:PackIconMaterial Kind="Close"
                                              Width="18" Height="18"
                                              Margin="0,0,8,0"/>
                        <TextBlock Text="Cerrar"/>
                    </StackPanel>
                </Button>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
