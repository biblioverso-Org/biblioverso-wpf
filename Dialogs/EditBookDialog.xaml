<UserControl x:Class="library.Dialogs.EditBookDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:converters="clr-namespace:library.Converters"
             MinWidth="560" MaxWidth="720" MaxHeight="525">

    <!-- Recursos -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Themes/CustomersTable.Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:SafeImageSourceConverter x:Key="SafeImg"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Padding="24"
          Background="{DynamicResource App.CardBrush}"
          BorderBrush="{DynamicResource App.BorderBrush}"
          BorderThickness="1"
          CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Título -->
            <TextBlock Grid.Row="0"
                 Text="Editar libro"
                 FontSize="20" FontWeight="SemiBold"
                 Foreground="{DynamicResource App.TextPrimaryBrush}"
                 Margin="0,0,0,16"/>

            <!-- Cuerpo -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Columna izquierda: portada -->
                <Grid Grid.Column="0">
                    <Ellipse Width="220" Height="220"
             Fill="{DynamicResource App.DividerBrush}"
             Opacity="0.25"
             HorizontalAlignment="Center" VerticalAlignment="Top"
             Margin="0,12,0,0"/>
                    <Border Width="240" Height="340"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            CornerRadius="8"
            BorderBrush="{DynamicResource App.BorderBrush}" BorderThickness="1">
                        <!-- preview portada -->
                        <Border.Background>
                            <ImageBrush Stretch="UniformToFill"
                        ImageSource="{Binding PortadaUrl, Converter={StaticResource SafeImg}}"/>
                        </Border.Background>
                    </Border>

                    <!-- Botones debajo de la imagen -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Content="Subir portada" 
                Command="{Binding UploadPortadaCommand}" 
                Margin="0,0,10,0"/>
                        <Button Content="Quitar" 
                Command="{Binding RemovePortadaCommand}"/>
                    </StackPanel>
                </Grid>


                <!-- Separador -->
                <Rectangle Grid.Column="1" Width="1"
                           Fill="{DynamicResource App.DividerBrush}"
                           HorizontalAlignment="Center"/>

                <!-- Columna derecha: formulario -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Bloque 1: Información básica -->
                        <TextBlock Text="📖 Información básica" 
                                   FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="Título" FontSize="12" 
                                   Foreground="{DynamicResource App.TextSecondaryBrush}"/>
                        <TextBox Text="{Binding Titulo}" Margin="0,2,0,10"/>

                        <TextBlock Text="Autor(es)" FontSize="12" 
                                   Foreground="{DynamicResource App.TextSecondaryBrush}"/>
                        <TextBox Text="{Binding AutoresTexto}" Margin="0,2,0,10"/>

                        <Separator Margin="0,8"/>

                        <!-- Bloque 2: Editorial y publicación -->
                        <TextBlock Text="🏷️ Publicación" 
                                   FontWeight="Bold" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Width="180">
                                <TextBlock Text="Editorial" FontSize="12" 
                                           Foreground="{DynamicResource App.TextSecondaryBrush}"/>
                                <TextBox Text="{Binding Editorial}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Width="150" Margin="12,0,0,0">
                                <TextBlock Text="ISBN" FontSize="12" 
                                           Foreground="{DynamicResource App.TextSecondaryBrush}"/>
                                <TextBox Text="{Binding Isbn}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Fecha de publicación" FontSize="12" 
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource App.TextSecondaryBrush}"/>
                        <DatePicker SelectedDate="{Binding FechaPublicacion}" Margin="0,2,0,10"/>

                        <Separator Margin="0,8"/>

                        <!-- Bloque 3: Valoración -->
                        <TextBlock Text="⭐ Valoración" 
                                   FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="Calificación (1 a 5)" FontSize="12" 
                                   Foreground="{DynamicResource App.TextSecondaryBrush}"/>
                        <TextBox Text="{Binding Rating}" Margin="0,2,0,10"/>

                        <Separator Margin="0,8"/>

                        <!-- Bloque 4: Sinopsis -->
                        <TextBlock Text="📝 Sinopsis" 
                                   FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding Sinopsis}" Height="150"
                                 AcceptsReturn="True" TextWrapping="Wrap"/>

                        <!-- Bloque 5: PDF Digital -->
                        <TextBlock Text="📄 Versión digital (opcional)" 
           FontWeight="Bold" Margin="0,6,0,4"/>

                        <StackPanel Orientation="Vertical" Margin="0,0,0,8">
                            <TextBox Text="{Binding PdfLocalPath}" Width="220"
             IsReadOnly="True"
             materialDesign:HintAssist.Hint="Seleccionar archivo PDF..."/>

                            <Button Margin="8,0,0,0" Padding="8,4"
            Command="{Binding SelectPdfCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <mah:PackIconMaterial Kind="FilePdfBox" Width="18" Height="18" Margin="0,0,6,0"/>
                                    <TextBlock Text="Buscar"/>
                                </StackPanel>
                            </Button>

                            <Button Margin="8,0,0,0" Padding="8,4"
            Command="{Binding UploadPdfCommand}"
            IsEnabled="{Binding IsPdfReady}">
                                <StackPanel Orientation="Horizontal">
                                    <mah:PackIconMaterial Kind="CloudUploadOutline" Width="18" Height="18" Margin="0,0,6,0"/>
                                    <TextBlock Text="Subir"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock Text="{Binding PdfStatus}"
           FontSize="12"
           Foreground="{DynamicResource App.TextSecondaryBrush}"/>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Footer -->
            <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,18,0,0">
                <Button DockPanel.Dock="Right" Margin="8,0,0,0"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                        CommandParameter="{x:Null}">
                    <StackPanel Orientation="Horizontal">
                        <mah:PackIconMaterial Kind="Close" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Cancelar"/>
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right"
                        IsEnabled="{Binding IsValid}"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                        CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal">
                        <mah:PackIconMaterial Kind="ContentSaveOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Guardar cambios"/>
                    </StackPanel>
                </Button>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
