<UserControl x:Class="library.Dialogs.ConfirmDeleteBookDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:converters="clr-namespace:library.Converters" xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             MinWidth="420" MaxWidth="520" MaxHeight="260">

    <UserControl.Resources>
        <converters:SafeImageSourceConverter x:Key="SafeImg"/>
    </UserControl.Resources>

    <Border Padding="20"
            Background="{DynamicResource App.CardBrush}"
            BorderBrush="{DynamicResource App.BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 🔹 Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <mah:PackIconMaterial Kind="TrashCanOutline" Width="22" Height="22"
                                      Foreground="{DynamicResource App.ErrorBrush}"/>
                <TextBlock Text="Eliminar libro"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource App.TextPrimaryBrush}"
                           Margin="8,0,0,0"/>
            </StackPanel>

            <!-- 🔹 Contenido principal -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="{Binding Titulo}" 
                           FontWeight="Bold" FontSize="16" 
                           Foreground="{DynamicResource App.TextPrimaryBrush}" 
                           TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding AutoresTexto}" 
                           FontSize="13" Foreground="{DynamicResource App.TextSecondaryBrush}" 
                           Margin="0,4,0,0" TextAlignment="Center"/>
                <TextBlock Text="{Binding Isbn}" 
                           FontSize="12" Foreground="{DynamicResource App.TextSecondaryBrush}" 
                           Margin="0,4,0,0" TextAlignment="Center"/>

                <!-- Mensaje de advertencia -->
                <Border Background="#FFFDECEA"
                        BorderBrush="#FFF5C6CB"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <mah:PackIconMaterial Kind="AlertOutline" Width="20" Height="20"
                                              Foreground="{DynamicResource App.ErrorBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="Esta acción no se puede deshacer. El libro será eliminado permanentemente."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.TextPrimaryBrush}" 
                                   FontSize="13"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 🔹 Footer -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Margin="0,0,8,0"
                        Background="Transparent"
                        BorderBrush="{DynamicResource App.BorderBrush}"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                        CommandParameter="{x:Static sys:Boolean.FalseString}">
                    <StackPanel Orientation="Horizontal">
                        <mah:PackIconMaterial Kind="Close" Width="16" Height="16" Margin="0,0,6,0"/>
                        <TextBlock Text="Cancelar"/>
                    </StackPanel>
                </Button>

                <Button Background="{DynamicResource App.ErrorBrush}"
                        Foreground="White"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                        CommandParameter="{x:Static sys:Boolean.TrueString}">
                    <StackPanel Orientation="Horizontal">
                        <mah:PackIconMaterial Kind="TrashCan" Width="16" Height="16" Margin="0,0,6,0"/>
                        <TextBlock Text="Eliminar"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
