<UserControl x:Class="library.Dialogs.AuthorDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Border Padding="20"
            Background="{DynamicResource App.CardBrush}"
            CornerRadius="10"
            Width="400"
            MaxHeight="600"
            SnapsToDevicePixels="True">

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Editar Autor" 
                           FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>

                <TextBox Text="{Binding Nombre}" 
                         materialDesign:HintAssist.Hint="Nombre" Margin="0,0,0,8"/>
                <TextBox Text="{Binding Nacionalidad}" 
                         materialDesign:HintAssist.Hint="Nacionalidad" Margin="0,0,0,8"/>
                <DatePicker SelectedDate="{Binding FechaNac}" Margin="0,0,0,8"/>
                <DatePicker SelectedDate="{Binding FechaMuerte}" Margin="0,0,0,8"/>
                <TextBox Text="{Binding Biografia}" 
                         materialDesign:HintAssist.Hint="Biografía" 
                         AcceptsReturn="True" Height="100" 
                         TextWrapping="Wrap" Margin="0,0,0,12"/>

                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Cancelar" 
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" 
                            Margin="0,0,8,0"/>
                    <Button Content="Guardar" 
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding SaveCommand}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
