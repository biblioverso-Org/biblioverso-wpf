<UserControl x:Class="library.Dialogs.AuthorDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Border Padding="20"
            Background="{DynamicResource App.CardBrush}"
            CornerRadius="10"
            Width="400"
            MaxHeight="650"
            SnapsToDevicePixels="True">

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="Editar Autor"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>

                <!-- 🖼️ Imagen del autor -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,12">
                    <Border Width="100" Height="100" CornerRadius="50" ClipToBounds="True">
                        <Image Source="{Binding FotoPreview}"
                               Stretch="UniformToFill"
                               Width="100" Height="100">
                            
                        </Image>
                    </Border>

                    <Button Content="Cambiar foto"
                            Margin="0,8,0,0"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding SelectImageCommand}" />
                </StackPanel>

                <!-- Campos -->
                <TextBox Text="{Binding Nombre}"
                         materialDesign:HintAssist.Hint="Nombre"
                         Margin="0,0,0,8"/>

                <TextBox Text="{Binding Nacionalidad}"
                         materialDesign:HintAssist.Hint="Nacionalidad"
                         Margin="0,0,0,8"/>

                <DatePicker SelectedDate="{Binding FechaNac}" 
                            materialDesign:HintAssist.Hint="Fecha de nacimiento"
                            Margin="0,0,0,8"/>

                <DatePicker SelectedDate="{Binding FechaMuerte}" 
                            materialDesign:HintAssist.Hint="Fecha de muerte"
                            Margin="0,0,0,8"/>

                <TextBox Text="{Binding Biografia}"
                         materialDesign:HintAssist.Hint="Biografía"
                         AcceptsReturn="True"
                         Height="100"
                         TextWrapping="Wrap"
                         Margin="0,0,0,12"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0">
                    <Button Content="Cancelar"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                            Margin="0,0,8,0"/>
                    <Button Content="Guardar"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding SaveCommand}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
