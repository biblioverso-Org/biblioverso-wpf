<UserControl x:Class="library.Dialogs.ManageStockDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:library.Converters">

    <UserControl.Resources>
        <converters:DistDiffToBrushConverter x:Key="DistDiffToBrush"/>
    </UserControl.Resources>

    <Border Padding="24"
            Background="{DynamicResource App.CardBrush}"
            BorderBrush="{DynamicResource App.BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Título -->
            <TextBlock Grid.Row="0"
                       Text="📦 Gestionar stock"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource App.TextPrimaryBrush}"
                       Margin="0,0,0,16"/>

            <!-- Cuerpo -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tarjetas de estados -->
                    <UniformGrid Grid.Column="0" Columns="3" Rows="2" Margin="0,0,10,0">

                        <!-- Nuevo -->
                        <Border Padding="12" Margin="6" CornerRadius="10"
                                Background="{DynamicResource App.CardBrush}"
                                BorderBrush="{DynamicResource App.BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <mah:PackIconMaterial Kind="BookPlus" Width="28" Height="28"
                                                      Foreground="{DynamicResource App.PrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="Nuevo" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding StockActualNuevo, StringFormat='Actual: {0}'}"
                                           Foreground="{DynamicResource App.TextSecondaryBrush}"/>
                                <TextBox Text="{Binding AdjNuevo, UpdateSourceTrigger=PropertyChanged, TargetNullValue=0, FallbackValue=0}"
                                         materialDesign:HintAssist.Hint="Ajuste (+/-)"/>
                                <TextBlock Text="{Binding NuevoFinal, StringFormat='Final: {0}'}"
                                           FontWeight="SemiBold" Foreground="{DynamicResource App.PrimaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Usado -->
                        <Border Padding="12" Margin="6" CornerRadius="10"
                                Background="{DynamicResource App.CardBrush}"
                                BorderBrush="{DynamicResource App.BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <mah:PackIconMaterial Kind="BookOpenVariant" Width="28" Height="28"
                                                      Foreground="{DynamicResource App.PrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="Usado" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding StockActualUsado, StringFormat='Actual: {0}'}"
                                           Foreground="{DynamicResource App.TextSecondaryBrush}"/>
                                <TextBox Text="{Binding AdjUsado, UpdateSourceTrigger=PropertyChanged, TargetNullValue=0, FallbackValue=0}"
                                         materialDesign:HintAssist.Hint="Ajuste (+/-)"/>
                                <TextBlock Text="{Binding UsadoFinal, StringFormat='Final: {0}'}"
                                           FontWeight="SemiBold" Foreground="{DynamicResource App.PrimaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Desgastado -->
                        <Border Padding="12" Margin="6" CornerRadius="10"
                                Background="{DynamicResource App.CardBrush}"
                                BorderBrush="{DynamicResource App.BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <mah:PackIconMaterial Kind="BookClock" Width="28" Height="28"
                                                      Foreground="{DynamicResource App.WarningBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="Desgastado" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding StockActualWorn, StringFormat='Actual: {0}'}"
                                           Foreground="{DynamicResource App.TextSecondaryBrush}"/>
                                <TextBox Text="{Binding AdjWorn, UpdateSourceTrigger=PropertyChanged, TargetNullValue=0, FallbackValue=0}"
                                         materialDesign:HintAssist.Hint="Ajuste (+/-)"/>
                                <TextBlock Text="{Binding WornFinal, StringFormat='Final: {0}'}"
                                           FontWeight="SemiBold" Foreground="{DynamicResource App.WarningBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Dañado -->
                        <Border Padding="12" Margin="6" CornerRadius="10"
                                Background="{DynamicResource App.CardBrush}"
                                BorderBrush="{DynamicResource App.BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <mah:PackIconMaterial Kind="BookCancel" Width="28" Height="28"
                                                      Foreground="{DynamicResource App.ErrorBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="Dañado" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding StockActualDamaged, StringFormat='Actual: {0}'}"
                                           Foreground="{DynamicResource App.TextSecondaryBrush}"/>
                                <TextBox Text="{Binding AdjDamaged, UpdateSourceTrigger=PropertyChanged, TargetNullValue=0, FallbackValue=0}"
                                         materialDesign:HintAssist.Hint="Ajuste (+/-)"/>
                                <TextBlock Text="{Binding DamagedFinal, StringFormat='Final: {0}'}"
                                           FontWeight="SemiBold" Foreground="{DynamicResource App.ErrorBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Reparado -->
                        <Border Padding="12" Margin="6" CornerRadius="10"
                                Background="{DynamicResource App.CardBrush}"
                                BorderBrush="{DynamicResource App.BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <mah:PackIconMaterial Kind="BookCheck" Width="28" Height="28"
                                                      Foreground="{DynamicResource App.SuccessBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="Reparado" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding StockActualRepaired, StringFormat='Actual: {0}'}"
                                           Foreground="{DynamicResource App.TextSecondaryBrush}"/>
                                <TextBox Text="{Binding AdjRepaired, UpdateSourceTrigger=PropertyChanged, TargetNullValue=0, FallbackValue=0}"
                                         materialDesign:HintAssist.Hint="Ajuste (+/-)"/>
                                <TextBlock Text="{Binding RepairedFinal, StringFormat='Final: {0}'}"
                                           FontWeight="SemiBold" Foreground="{DynamicResource App.SuccessBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- En restauración -->
                        <Border Padding="12" Margin="6" CornerRadius="10"
                                Background="{DynamicResource App.CardBrush}"
                                BorderBrush="{DynamicResource App.BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <mah:PackIconMaterial Kind="BookCog" Width="28" Height="28"
                                                      Foreground="{DynamicResource App.PrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="En restauración" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding StockActualRestoring, StringFormat='Actual: {0}'}"
                                           Foreground="{DynamicResource App.TextSecondaryBrush}"/>
                                <TextBox Text="{Binding AdjRestoring, UpdateSourceTrigger=PropertyChanged, TargetNullValue=0, FallbackValue=0}"
                                         materialDesign:HintAssist.Hint="Ajuste (+/-)"/>
                                <TextBlock Text="{Binding RestoringFinal, StringFormat='Final: {0}'}"
                                           FontWeight="SemiBold" Foreground="{DynamicResource App.PrimaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                    </UniformGrid>

                    <!-- Resumen -->
                    <Border Grid.Column="2" Padding="16" CornerRadius="10"
                            Background="{DynamicResource App.CardBrush}"
                            BorderBrush="{DynamicResource App.BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Resumen" FontWeight="SemiBold" Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                <TextBlock Text="📦 Stock actual:" Width="160"/>
                                <TextBlock Text="{Binding StockActualTotal}" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                <TextBlock Text="✅ Total final:" Width="160"/>
                                <TextBlock Text="{Binding StockFinalTotal}" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="⚖ Diferencia:" Width="160"/>
                                <TextBlock Text="{Binding Diferencia}"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding Diferencia, Converter={StaticResource DistDiffToBrush}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- Footer -->
            <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,18,0,0">
                <Button DockPanel.Dock="Right" Margin="8,0,0,0"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                        CommandParameter="{x:Null}">
                    <TextBlock Text="Cancelar"/>
                </Button>
                <Button DockPanel.Dock="Right"
                        IsEnabled="{Binding CanSave}"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                        CommandParameter="{Binding}">
                    <TextBlock Text="Guardar"/>
                </Button>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
