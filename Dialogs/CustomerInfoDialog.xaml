<UserControl x:Class="library.Dialogs.CustomerInfoDialog"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
              xmlns:mah="http://metro.mahapps.com/winfx/xaml/iconpacks"
              MinWidth="500" MaxWidth="600">

    <Border Padding="24,20,24,16"
          Background="{DynamicResource App.CardBrush}"
          BorderBrush="{DynamicResource App.BorderBrush}"
          BorderThickness="1" CornerRadius="10">

        <StackPanel>
            <TextBlock Text="Información del cliente"
                       FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"
                       Foreground="{DynamicResource App.TextPrimaryBrush}"/>

            <TextBlock Text="{Binding Cliente.NombreCompleto}" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="{Binding Cliente.Email}" Foreground="Gray"/>
            <Separator Margin="0,10,0,10"/>

            <TextBlock Text="Teléfono:" FontWeight="Bold"/>
            <TextBlock Text="{Binding Cliente.Telefono}"/>

            <TextBlock Text="Dirección:" FontWeight="Bold"/>
            <TextBlock Text="{Binding Cliente.Direccion}"/>

            <TextBlock Text="Género:" FontWeight="Bold"/>
            <TextBlock Text="{Binding Cliente.Genero}"/>

            <TextBlock Text="Fecha de nacimiento:" FontWeight="Bold"/>
            <TextBlock Text="{Binding Cliente.FechaNacimiento, StringFormat=d}"/>

            <TextBlock Text="Nacionalidad:" FontWeight="Bold"/>
            <TextBlock Text="{Binding Cliente.Nacionalidad}"/>

            <TextBlock Text="Biografía:" FontWeight="Bold"/>
            <TextBlock Text="{Binding Cliente.Biografia}" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <Button HorizontalAlignment="Right"
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                    >
                <StackPanel Orientation="Horizontal">
                    <mah:PackIconMaterial Kind="Close" Width="18" Height="18" Margin="0,0,8,0"/>
                    <TextBlock Text="Cerrar"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
