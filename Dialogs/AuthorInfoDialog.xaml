<UserControl x:Class="library.Dialogs.AuthorInfoDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Border Padding="20"
             Background="{DynamicResource App.CardBrush}"
            CornerRadius="10"
            Width="400"
            MaxHeight="500"
            SnapsToDevicePixels="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding Autor.Nombre}" 
                           FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding Autor.Nacionalidad}" 
                           FontStyle="Italic" Margin="0,0,0,12"/>

                <TextBlock Text="Biografía:" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Autor.Biografia}" 
                           TextWrapping="Wrap" Margin="0,0,0,12"/>

                <TextBlock Text="Nacimiento:" FontWeight="Bold"/>
                <TextBlock Text="{Binding Autor.FechaNac, StringFormat=d}"/>
                <TextBlock Text="Muerte:" FontWeight="Bold" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding Autor.FechaMuerte, StringFormat=d}"/>

                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="Cerrar" 
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
